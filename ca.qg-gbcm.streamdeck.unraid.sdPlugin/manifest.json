{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Unraid",
	"Version": "1.0.0.0",
	"Author": "Patrice Guillemette",
	"Actions": [
		{
			"Name": "Array state",
			"UUID": "ca.qg-gbcm.streamdeck.unraid.arraystate",
			"Icon": "imgs/actions/array/icon",
			"Tooltip": "Displays the array state and toggle it.",
			"PropertyInspectorPath": "ui/arraystate.html",
			"UserTitleEnabled": true,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/array/icon",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Docker state",
			"UUID": "ca.qg-gbcm.streamdeck.unraid.dockerstate",
			"Icon": "imgs/actions/docker/icon",
			"Tooltip": "Displays the docker state and toggle it.",
			"PropertyInspectorPath": "ui/dockerstate.html",
			"UserTitleEnabled": true,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/docker/icon",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Server stats",
			"UUID": "ca.qg-gbcm.streamdeck.unraid.serverstats",
			"Icon": "imgs/actions/server/icon",
			"Tooltip": "Displays global server statistics.",
			"PropertyInspectorPath": "ui/serverstats.html",
			"UserTitleEnabled": true,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/server/icon",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "UPS Status",
			"UUID": "ca.qg-gbcm.streamdeck.unraid.upsstate",
			"Icon": "imgs/actions/ups/icon",
			"Tooltip": "Displays UPS battery charge, load and status.",
			"PropertyInspectorPath": "ui/upsstate.html",
			"UserTitleEnabled": false,
			"Controllers": ["Keypad"],
			"States": [
				{
				"Image": "imgs/actions/ups/icon",
				"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "VM State",
			"UUID": "ca.qg-gbcm.streamdeck.unraid.vmstate",
			"Icon": "imgs/actions/vm/icon",
			"Tooltip": "Affiche l'état d'une VM et permet de la démarrer/arrêter.",
			"PropertyInspectorPath": "ui/vmstate.html",
			"UserTitleEnabled": true,
			"Controllers": ["Keypad"],
			"States": [
				{
				"Image": "imgs/actions/vm/icon",
				"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Storage Array",
			"UUID": "ca.qg-gbcm.streamdeck.unraid.storagestate",
			"Icon": "imgs/actions/storage/icon",
			"Tooltip": "Affiche l'utilisation du stockage principal (Array).",
			"PropertyInspectorPath": "ui/storagestate.html",
			"UserTitleEnabled": false,
			"Controllers": ["Keypad"],
			"States": [
				{
				"Image": "imgs/actions/storage/icon",
				"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Network Traffic",
			"UUID": "ca.qg-gbcm.streamdeck.unraid.networkstate",
			"Icon": "imgs/actions/network/icon",
			"Tooltip": "Affiche le trafic réseau RX/TX en temps réel.",
			"PropertyInspectorPath": "ui/networkstate.html",
			"UserTitleEnabled": false,
			"Controllers": ["Keypad"],
			"States": [
				{
				"Image": "imgs/actions/network/icon",
				"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Temperatures",
			"UUID": "ca.qg-gbcm.streamdeck.unraid.temperaturestate",
			"Icon": "imgs/actions/temperature/icon",
			"Tooltip": "Affiche le capteur le plus chaud du serveur.",
			"PropertyInspectorPath": "ui/temperaturestate.html",
			"UserTitleEnabled": false,
			"Controllers": ["Keypad"],
			"States": [
				{
				"Image": "imgs/actions/temperature/icon",
				"TitleAlignment": "bottom"
				}
			]
		}
	],
	"Category": "Unraid",
	"CategoryIcon": "imgs/plugin/pluginIcon",
	"CodePath": "bin/plugin.js",
	"Description": "Plugin made to control unraid disk array and dockers containers",
	"Icon": "imgs/plugin/pluginIcon",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"UUID": "ca.qg-gbcm.streamdeck.unraid"
}